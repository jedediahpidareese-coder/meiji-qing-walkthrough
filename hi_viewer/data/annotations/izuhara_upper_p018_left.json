    "body": [
      {
        "purpose": "transcribing",
        "value": "但迎使三人上下九人通詞三人卒族拾貳人船附之者六人長崎逗留"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "ただし、迎使三人、上下九人、通詞三人、卒族十二人、船付きの者六人、長崎逗留。"
      },
      {
        "purpose": "english_translation",
        "value": "Note: welcoming envoys, three persons — nine persons counting their attendants; interpreters, three persons; men of sotsu rank, twelve persons; persons attached to the ship, six persons. They stayed at Nagasaki."
      },
      {
        "purpose": "identifying",
        "value": "但書迎使一行人數"
      }
    ],
