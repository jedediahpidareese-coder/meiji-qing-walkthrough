  {
    "id": "anno-izuhara_upper_p021_right-01",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "但右同斷ニ付兩關所ニテ召仕候人夫ゟ相與候飯米之分如斯"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "ただし、右同断につき、両関所にて召し仕え候人夫より相与え候飯米の分、かくのごとし"
      },
      {
        "purpose": "english_translation",
        "value": "Note: on the same account as the entry at right, this is the rice ration issued to the labourers employed at the two barrier stations. (The amount this note explains stands at the end of the preceding page.)"
      },
      {
        "purpose": "identifying",
        "value": "兩關所人夫飯米但書"
      }
    ],
    "target": {
      "source": "images/upper_p021_right.jpg",
