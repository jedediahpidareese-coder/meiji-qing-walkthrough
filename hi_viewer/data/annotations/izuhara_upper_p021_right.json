    "body": [
      {
        "purpose": "transcribing",
        "value": "但和漂民護送使上士壹人上下四人卒族貳人船附壹人大坂長崎之"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "ただし、和漂民護送使、上士一人、上下四人、卒族二人、船付一人、大坂・長崎の"
      },
      {
        "purpose": "english_translation",
        "value": "Note (first column): for the mission escorting Japanese castaways — one senior samurai, four attendants, two sotsu-rank men, one ship hand — between Osaka and Nagasaki,"
      },
      {
        "purpose": "identifying",
        "value": "和漂民護送使但書上"
