        "purpose": "transcribing",
        "value": "百カ"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "百ヵ"
      },
      {
        "purpose": "english_translation",
        "value": "Editorial conjecture in small type: perhaps 百. It stands to the right of the cash figure in the next column, level with the first 拾 in that figure, proposing 三千三百四拾四貫 in place of the printed 三千三拾四拾四貫."
      },
      {
        "purpose": "identifying",
        "value": "校訂註百ヵ"
      }
    ],
