    "id": "anno-nakatsu_lower_p193_left-00",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "○中津藩"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "中津藩（なかつはん）"
      },
      {
        "purpose": "english_translation",
        "value": "Nakatsu Domain — the maru-marker opening this domain's Fascicle 9 entry. It is the rightmost inked element on the leaf: a column projection over y900-3600 finds no ink between x2650 and x3064, so nothing here belongs to the preceding domain. Everything from this marker leftward as far as the ○中村藩 marker is Nakatsu's."
      },
      {
        "purpose": "identifying",
        "value": "○中津藩"
      }
    ],
    "target": {
      "source": "images/lower_p193_left.jpg",
