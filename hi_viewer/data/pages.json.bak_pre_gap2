   "domain_en": "Nakatsu",
   "image": "images/lower_p193_left.jpg",
   "volume": "vol2",
   "pdf_page": 193,
   "page_side": "L",
   "book_page": "",
   "page_header_kanji": "藩制一覽表第九 （中津、中村）",
   "page_header_en": "Domain Survey (藩制一覧表), Fascicle 9 — Nakatsu (中津藩) and Nakamura (中村藩): officials and military",
   "table_number": 9,
   "page_topic": "Nakatsu officials &amp; military, into Nakamura",
   "page_summary_en": "This is an officials-and-military leaf from the ninth fascicle, read right to left, spanning two domains. The ○中津藩 boundary marker opens Nakatsu (the Okudaira house of Buzen): its official establishment count is recorded as 不詳 (not detailed), and its army (兵隊, troops) is given as 1,059 samurai (士) and 878 lower-samurai (卒), for 1,937 in all. Its senior officials then follow by rank — senior councillors (大参事), junior-senior councillors (権大参事), and junior councillors (少参事) — with the last two Nakatsu names overflowing to the right of the next marker but still belonging to Nakatsu. The ○中村藩 marker then opens Nakamura (the Sōma-Nakamura house of Mutsu), whose named councillors hang in columns below their rank headings; Nakamura's record continues onto the following page."
  },
  {
   "id": "wakayama_upper_p086_left",
   "sequence": 51,
   "domain_canonical": "和歌山藩",
   "domain_hi_name": "和歌山藩",
   "domain_en": "Wakayama (Kii)",
   "image": "images/upper_p086_left.jpg",
   "volume": "vol1",
